# Produksjonsserveren (npm run prod): egen database og port, så dev (npm run dev, port 8787) kan gå ved siden av.
# Cloudflare-tunnelen sender julemarket.bagel.no hit (se DRIFT.md).
PORT=8080
DB_PATH=data/prod/julemarked.db
# Brukes bare første gang, når markedet opprettes i en tom database:
INVITE_CODE=GLOGG
MARKET_NAME=Julemarkedet
GAME_SPEED=1
GAME_START=now
